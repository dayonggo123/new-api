{
  "manifest_version": 3,
  "name": "Prompt Collector - 提示词采集器",
  "version": "1.4.2",
  "description": "从任意网页一键采集提示词（支持 opennana.com、微信公众号、youmind 等视频/图片 prompt 平台）到 new-api",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://opennana.com/awesome-prompt-gallery*"
      ],
      "js": ["content-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://opennana.com/awesome-prompt-gallery/*"
      ],
      "js": ["content-detail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mp.weixin.qq.com/s/*",
        "https://mp.weixin.qq.com/s?*"
      ],
      "js": ["content-wechat.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://youmind.com/*"
      ],
      "js": ["content-youmind.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://opennana.com/awesome-prompt-gallery*",
        "https://mp.weixin.qq.com/s/*",
        "https://mp.weixin.qq.com/s?*",
        "https://youmind.com/*"
      ],
      "js": ["content-universal.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
